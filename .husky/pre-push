#!/usr/bin/env sh
# Belt-and-suspenders re-check of the same AGENTS.md rule pre-commit already guards (P-09: AGENTS.md is
# public now) — catches a commit that predates this hook or was made with --no-verify. Checks the tracked
# HEAD content directly (not a staged diff — there is none at push time). Scoped to §1 only — see
# pre-commit's identical comment for why a whole-file ban would reject the file's own legitimate content.
if git show "HEAD:AGENTS.md" 2>/dev/null | awk '/^## 1\. /{f=1} /^## 2\./{f=0} f' \
  | grep -qE "ecom docs|STRATEGY\.md|HOW-WE-GOT-HERE|my-tasks|roadmap\.md"; then
  echo "ERROR: the tracked AGENTS.md's section 1 names a private planning path (ecom docs / STRATEGY.md /"
  echo "HOW-WE-GOT-HERE / my-tasks / roadmap.md). Fix it and amend before pushing."
  exit 1
fi

echo "pre-push: running the full local regression (typecheck/lint/format/license-scan/build/test/coverage) — this can take a minute..."

pnpm build || exit 1
pnpm typecheck || exit 1
pnpm lint || exit 1
pnpm format || exit 1
pnpm license-scan || exit 1
pnpm test || exit 1
pnpm coverage || exit 1
node --test tools/codegen/model/*.test.mjs tools/conformance/oracle-e-invoice-eu/*.test.mjs tools/conformance/oracle-stackforge-facturx/*.test.mjs tools/license-scan/*.test.mjs || exit 1

echo "pre-push checks passed."
echo "Not run here (both are CI-only — the Docker-based one is slow, the codegen one mutates files as a"
echo "side effect of checking them): the codegen-determinism gates and the Docker conformance suite"
echo "(KoSIT/veraPDF/Mustang, L1-L5). Run 'pnpm codegen && git status' or 'pnpm conformance:fixtures' etc."
echo "yourself before a release, or rely on CI once this repo has a GitHub remote."
