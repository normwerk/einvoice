#!/usr/bin/env sh
# Belt-and-suspenders re-check of the same AGENTS.md rule pre-commit already guards — catches the case
# where a commit predates this hook, or was made with --no-verify. Checks what's actually tracked, not a
# staged diff (there is none at push time).
if git ls-files --error-unmatch AGENTS.md > /dev/null 2>&1; then
  echo "ERROR: AGENTS.md is tracked by git. This file must never be committed."
  echo "Remove it from tracking (the file itself stays on disk): git rm --cached AGENTS.md"
  exit 1
fi

echo "pre-push: running the full local regression (typecheck/lint/format/license-scan/build/test/coverage) — this can take a minute..."

pnpm build || exit 1
pnpm typecheck || exit 1
pnpm lint || exit 1
pnpm format || exit 1
pnpm license-scan || exit 1
pnpm test || exit 1
pnpm coverage || exit 1
node --test tools/codegen/model/*.test.mjs tools/conformance/oracle-e-invoice-eu/*.test.mjs tools/conformance/oracle-stackforge-facturx/*.test.mjs tools/license-scan/*.test.mjs || exit 1

echo "pre-push checks passed."
echo "Not run here (both are CI-only — the Docker-based one is slow, the codegen one mutates files as a"
echo "side effect of checking them): the codegen-determinism gates and the Docker conformance suite"
echo "(KoSIT/veraPDF/Mustang, L1-L5). Run 'pnpm codegen && git status' or 'pnpm conformance:fixtures' etc."
echo "yourself before a release, or rely on CI once this repo has a GitHub remote."
