engine-strict=true
save-workspace-protocol=rolling

# packages/einvoice-medusa (Medusa v2 admin bundling needs a single React/router instance across the
# plugin and whatever consumes it — verified against create-medusa-app's own generated plugin .npmrc).
public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom
