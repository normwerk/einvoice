{
  "name": "einvoice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "coverage": "pnpm -r coverage",
    "conformance": "node packages/einvoice-conformance/dist/cli.js",
    "conformance:fixtures": "node tools/conformance/serialize-and-validate-fixtures.mjs",
    "conformance:roundtrip": "node tools/conformance/roundtrip-mustang.mjs",
    "conformance:oracle-eu": "node tools/conformance/oracle-e-invoice-eu.mjs",
    "conformance:oracle-facturx": "node tools/conformance/oracle-stackforge-facturx.mjs",
    "conformance:pdfa": "node tools/conformance/pdfa-embed-and-validate.mjs",
    "conformance:commerce": "node tools/conformance/build-commerce-fixtures.mjs",
    "codegen:model": "node tools/codegen/model/generate.mjs",
    "codegen:cii-mapping": "pnpm --filter @normwerk/einvoice-cii build && node tools/codegen/cii/generate-mapping-reference.mjs",
    "codegen:pdfa": "node tools/codegen/pdfa/generate-icc-profile.mjs && node tools/codegen/pdfa/generate-fonts.mjs",
    "codegen:commerce": "node tools/codegen/commerce/generate-json-schema.mjs",
    "codegen": "pnpm codegen:model && pnpm codegen:cii-mapping && pnpm codegen:pdfa && pnpm codegen:commerce",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "license-scan": "node tools/license-scan/scan.mjs",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@e-invoice-eu/core": "^3.3.0",
    "@eslint/js": "^9.15.0",
    "@stackforge-eu/factur-x": "^1.4.0",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.5",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.3.3",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
