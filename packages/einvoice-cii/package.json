{
  "name": "@normwerk/einvoice-cii",
  "version": "0.1.0",
  "description": "UN/CEFACT CII D16B serializer and profiles (XRechnung 3.0, ZUGFeRD).",
  "type": "module",
  "license": "MIT",
  "author": "normwerk",
  "homepage": "https://normwerk.dev",
  "bugs": "https://github.com/normwerk/einvoice/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/normwerk/einvoice.git",
    "directory": "packages/einvoice-cii"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "en16931",
    "cii",
    "xrechnung",
    "zugferd",
    "factur-x",
    "e-invoice",
    "einvoicing",
    "xml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "dependencies": {
    "@normwerk/einvoice-model": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "node ../../tools/publish/strip-test-output.mjs dist"
  }
}
