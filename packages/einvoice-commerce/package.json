{
  "name": "@normwerk/einvoice-commerce",
  "version": "0.1.0",
  "description": "Order/refund to EN 16931 tax semantics. Platform-agnostic: no Medusa or Vendure types.",
  "type": "module",
  "license": "MIT",
  "author": "normwerk",
  "homepage": "https://github.com/Normwerk/eInvoice#readme",
  "bugs": "https://github.com/Normwerk/eInvoice/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Normwerk/eInvoice.git",
    "directory": "packages/einvoice-commerce"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "en16931",
    "e-invoice",
    "einvoicing",
    "xrechnung",
    "vat",
    "tax",
    "e-commerce"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "dependencies": {
    "@normwerk/einvoice-model": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "scripts": {
    "codegen": "node ../../tools/codegen/commerce/generate-json-schema.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "node ../../tools/publish/strip-test-output.mjs dist"
  }
}
