{
  "name": "@normwerk/einvoice-medusa",
  "version": "0.1.0",
  "description": "Thin Medusa v2 plugin: subscribes to platform events, maps entities to CommerceInvoiceInput, stores the result. No tax logic, no XML (AGENTS.md §6) — those live in @normwerk/einvoice-commerce and @normwerk/einvoice-cii.",
  "private": true,
  "author": "normwerk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/normwerk/eInvoice"
  },
  "files": [
    ".medusa/server",
    "!.medusa/server/**/*.test.js",
    "!.medusa/server/**/*.test.js.map",
    "!.medusa/server/**/*.test.d.ts",
    "!.medusa/server/**/*.test.d.ts.map"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./links": "./.medusa/server/src/links/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-plugin",
    "e-invoicing",
    "xrechnung",
    "en16931",
    "zugferd",
    "factur-x"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "node ../../tools/publish/strip-test-output.mjs .medusa/server"
  },
  "dependencies": {
    "@normwerk/einvoice-cii": "workspace:*",
    "@normwerk/einvoice-commerce": "workspace:*",
    "@normwerk/einvoice-model": "workspace:*",
    "@normwerk/einvoice-pdfa": "workspace:*"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@swc/core": "^1.7.28",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.4.0",
    "@medusajs/cli": ">=2.4.0",
    "@medusajs/framework": ">=2.4.0",
    "@medusajs/icons": ">=2.4.0",
    "@medusajs/medusa": ">=2.4.0",
    "@medusajs/test-utils": ">=2.4.0",
    "@medusajs/ui": ">=4.0.0",
    "@webbers/invoices-medusa": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@webbers/invoices-medusa": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
