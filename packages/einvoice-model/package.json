{
  "name": "@normwerk/einvoice-model",
  "version": "0.1.0",
  "description": "Generated EN 16931 types, code lists, and JSON Schema (model layer: no logic, no I/O).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "normwerk",
  "keywords": [
    "en16931",
    "e-invoice",
    "einvoicing",
    "xrechnung",
    "zugferd",
    "factur-x",
    "xml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "codegen": "node ../../tools/codegen/model/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "node ../../tools/publish/strip-test-output.mjs dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
