{
  "name": "@normwerk/einvoice-pdfa",
  "version": "0.1.0",
  "description": "PDF/A-3b assembly with an embedded invoice XML (ZUGFeRD/Factur-X).",
  "type": "module",
  "license": "MIT",
  "author": "normwerk",
  "homepage": "https://github.com/Normwerk/eInvoice#readme",
  "bugs": "https://github.com/Normwerk/eInvoice/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Normwerk/eInvoice.git",
    "directory": "packages/einvoice-pdfa"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "pdf/a-3",
    "pdf/a",
    "zugferd",
    "factur-x",
    "e-invoice",
    "einvoicing",
    "pdf"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "dependencies": {
    "@normwerk/einvoice-model": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepack": "node ../../tools/publish/strip-test-output.mjs dist"
  }
}
